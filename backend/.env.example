# 环境配置示例
# 复制此文件为 .env，并填入实际的 API Key

PORT=3000

# 百度地图 API Key（必填，用于逆地理编码）
BAIDU_MAP_API_KEY=your_baidu_map_api_key_here

# 百度地图 API Referer（本地开发默认值即可）
BAIDU_MAP_REFERER=http://localhost:8000/

# 和风天气 API Key（必填，用于天气和空气质量）
QWEATHER_API_KEY=your_qweather_api_key_here

# 和风天气 API Host（如你有专属 apihost，填这里）
QWEATHER_API_HOST=nq5rk7bfry.re.qweatherapi.com

# 数据库配置（如需要）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=haze_detection
DB_USER=postgres
DB_PASSWORD=your_password_here

# 日志级别
LOG_LEVEL=info

# 缓存配置
CACHE_TTL_WEATHER=3600
CACHE_TTL_AQI=1800

# CORS 配置
CORS_ORIGIN=http://localhost:3000
