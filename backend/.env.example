# 环境配置示例
# 复制此文件为 .env，并填入实际的 API Key

PORT=3000

# 百度地图 API Key
BAIDU_MAP_API_KEY=your_baidu_map_api_key_here

# 天气 API 配置
WEATHER_API_PROVIDER=baidu
BAIDU_WEATHER_API_KEY=your_baidu_weather_api_key_here
QWEATHER_API_KEY=your_qweather_api_key_here

# 数据库配置（如需要）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=haze_detection
DB_USER=postgres
DB_PASSWORD=your_password_here

# 日志级别
LOG_LEVEL=info

# 缓存配置
CACHE_TTL_WEATHER=3600
CACHE_TTL_AQI=1800

# CORS 配置
CORS_ORIGIN=http://localhost:3000
